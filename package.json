{
  "name": "monorepo-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "harness": "./dist/cli/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "tsx src/cli/run.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "commander": "^12.1.0",
    "fs-ext": "2.1.1",
    "minimatch": "^10.0.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
